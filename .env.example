# Atoms 容器化部署环境变量模板（工单 0013 / 0014）。
# 用法：复制为 .env（仓库根目录）后填写；docker compose 会自动读取并注入。
# 所有配置项均以 ATOMS_ 前缀，语义与默认值见 backend/app/config.py。

# ===== 必填 =====
# 登录令牌签名密钥：>=32 字节随机串，例如 `openssl rand -hex 32`
ATOMS_JWT_SECRET=
# MiniMax（OpenAI 兼容）API Key：生成与 embedding 共用
ATOMS_LLM_API_KEY=

# ===== LLM（OpenAI 兼容） =====
ATOMS_LLM_BASE_URL=https://api.minimaxi.com/v1
ATOMS_LLM_MODEL=MiniMax-M3
ATOMS_LLM_TEMPERATURE=0.2
# 智能体单次生成的最大工具循环步数与失败重试次数
ATOMS_AGENT_MAX_STEPS=20
ATOMS_AGENT_MAX_RETRIES=2

# ===== embedding（置空则复用 LLM 端点与 Key） =====
ATOMS_EMBEDDING_MODEL=embo-01
ATOMS_EMBEDDING_BASE_URL=
ATOMS_EMBEDDING_API_KEY=

# ===== 生成限流（工单 0011；0014 建议线上保守值） =====
# 每用户每小时生成上限（<=0 不限）
ATOMS_RATE_LIMIT_PER_USER_HOURLY=10
# 全局同时进行的生成上限（<=0 不限）
ATOMS_RATE_LIMIT_MAX_CONCURRENT=2

# ===== 登录有效期（分钟，默认 7 天） =====
ATOMS_JWT_EXPIRES_MINUTES=10080

# ===== 存储路径（容器内固定值，一般无需改动） =====
# SQLite / Milvus Lite / 生成文件均落数据卷；
# backend 与 web 必须挂同一路径（公开链接符号链接为绝对目标）
ATOMS_DATABASE_URL=sqlite:////app/data/atoms.db
ATOMS_STORAGE_ROOT=/app/data/storage
ATOMS_MILVUS_URI=/app/data/milvus/atoms.db

# ===== 其他 =====
# 对外端口（nginx 宿主端口）
ATOMS_HTTP_PORT=80
# 跨域来源：同源部署留空；本地前端直连容器时填 http://localhost:5173
ATOMS_CORS_ORIGINS=
